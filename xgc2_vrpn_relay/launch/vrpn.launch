<launch>
  <!-- Own rigid body only. refresh_tracker_frequency=0 disables
       auto-discovery of every tracker on the Motive server. -->
  <arg name="server" default="127.0.0.1" />
  <arg name="port" default="3883" />
  <arg name="tracker" default="tracker" />
  <arg name="update_frequency" default="100.0" />
  <arg name="frame_id" default="world" />
  <arg name="use_server_time" default="false" />
  <arg name="broadcast_tf" default="false" />

  <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node"
        output="screen">
    <rosparam subst_value="true">
      server: $(arg server)
      port: $(arg port)
      update_frequency: $(arg update_frequency)
      frame_id: $(arg frame_id)
      use_server_time: $(arg use_server_time)
      broadcast_tf: $(arg broadcast_tf)
      refresh_tracker_frequency: 0.0
      trackers: ["$(arg tracker)"]
    </rosparam>
  </node>
</launch>
