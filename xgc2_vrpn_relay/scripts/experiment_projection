#!/usr/bin/env python3
"""Project one selected VRPN body into an Experiment namespace.

External contract is four domain parameters: source_root, mocap_rigid_body,
robot_namespace, and publish_vision. The node uniquely derives
source_root/body/{pose,twist,accel} inputs and namespace/{pose,twist,accel}
outputs. When publish_vision is true it also publishes
namespace/mavros/vision_pose/pose.

The node applies one explicit XYZ translation to PoseStamped. Orientation and
header stamp are preserved. Twist/Accel pass through unchanged. Vision output
uses the same translated pose at a bounded wall-clock rate.
"""

from __future__ import print_function

import copy
import os
import sys
import time

import rospy
from geometry_msgs.msg import AccelStamped, PoseStamped, TwistStamped

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from xgc2_vrpn_relay.projection import (
    EXPLICIT_TOPIC_PARAMS,
    derive_experiment_topics,
    finite_values,
    translated_position,
    valid_pose,
)
from xgc2_vrpn_relay.rate import should_emit_vision


def main():
    rospy.init_node("experiment_localization_projection")
    for name in EXPLICIT_TOPIC_PARAMS:
        if rospy.has_param("~" + name):
            raise rospy.ROSInitException(
                "~{} is not an Experiment projection parameter; "
                "topics are derived from source_root, mocap_rigid_body, "
                "robot_namespace, and publish_vision".format(name)
            )
    try:
        topics = derive_experiment_topics(
            rospy.get_param("~source_root"),
            rospy.get_param("~mocap_rigid_body"),
            rospy.get_param("~robot_namespace"),
            rospy.get_param("~publish_vision", False),
        )
    except ValueError as exc:
        raise rospy.ROSInitException(str(exc))

    offset_x = float(rospy.get_param("~offset_x", 0.0))
    offset_y = float(rospy.get_param("~offset_y", 0.0))
    offset_z = float(rospy.get_param("~offset_z", 0.0))
    vision_hz = float(rospy.get_param("~vision_target_hz", 30.0))
    if not finite_values(offset_x, offset_y, offset_z, vision_hz) or (
        topics["vision_out"] and vision_hz <= 0.0
    ):
        raise rospy.ROSInitException(
            "offsets and vision_target_hz must be finite; enabled vision requires a positive rate"
        )

    pose_pub = rospy.Publisher(topics["pose_out"], PoseStamped, queue_size=1)
    twist_pub = rospy.Publisher(topics["twist_out"], TwistStamped, queue_size=1)
    accel_pub = rospy.Publisher(topics["accel_out"], AccelStamped, queue_size=1)
    vision_pub = (
        rospy.Publisher(topics["vision_out"], PoseStamped, queue_size=1)
        if topics["vision_out"]
        else None
    )
    last_vision = [None]

    def on_pose(message):
        p = message.pose.position
        q = message.pose.orientation
        if not valid_pose(p.x, p.y, p.z, q.x, q.y, q.z, q.w):
            rospy.logwarn_throttle(2.0, "drop invalid Experiment localization pose")
            return
        if message.header.stamp == rospy.Time():
            rospy.logwarn_throttle(2.0, "drop unstamped Experiment localization pose")
            return
        projected = copy.deepcopy(message)
        x, y, z = translated_position(p.x, p.y, p.z, offset_x, offset_y, offset_z)
        projected.pose.position.x = x
        projected.pose.position.y = y
        projected.pose.position.z = z
        pose_pub.publish(projected)
        if vision_pub is not None:
            # Release packages target Melodic/Python 2 as well as Noetic.
            # This is only an emit-rate clock; source stamps remain untouched.
            now = time.time()
            if should_emit_vision(now, last_vision[0], vision_hz):
                last_vision[0] = now
                vision_pub.publish(projected)

    def on_twist(message):
        value = message.twist
        if finite_values(
            value.linear.x, value.linear.y, value.linear.z,
            value.angular.x, value.angular.y, value.angular.z,
        ):
            twist_pub.publish(message)

    def on_accel(message):
        value = message.accel
        if finite_values(
            value.linear.x, value.linear.y, value.linear.z,
            value.angular.x, value.angular.y, value.angular.z,
        ):
            accel_pub.publish(message)

    rospy.Subscriber(topics["pose_in"], PoseStamped, on_pose, queue_size=1, tcp_nodelay=True)
    rospy.Subscriber(topics["twist_in"], TwistStamped, on_twist, queue_size=1, tcp_nodelay=True)
    rospy.Subscriber(topics["accel_in"], AccelStamped, on_accel, queue_size=1, tcp_nodelay=True)
    rospy.loginfo(
        "Experiment localization projection %s/%s -> %s offset=(%.3f, %.3f, %.3f) vision=%s@%.1fHz",
        rospy.get_param("~source_root"),
        rospy.get_param("~mocap_rigid_body"),
        rospy.get_param("~robot_namespace"),
        offset_x,
        offset_y,
        offset_z,
        topics["vision_out"] or "off",
        vision_hz,
    )
    rospy.spin()


if __name__ == "__main__":
    try:
        main()
    except rospy.ROSInterruptException:
        sys.exit(0)
